{
  "expo": {
    "name": "GPS Nopeusmittari",
    "slug": "mobile-gps",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/skick.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080808",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "image": "./assets/skick.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080808",
            "image": "./assets/skick.png"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amateurcoder316.mobilegps",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sijaintia käytetään nopeuden ja kuljetun matkan mittaamiseen GPS:n avulla."
      }
    },
    "android": {
      "package": "com.amateurcoder316.mobilegps",
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/skick.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/skick.png"
    },
    "extra": {
      "eas": {
        "projectId": "9fafa70f-fc3b-4a46-9877-6d688f7b1eec"
      }
    }
  }
}
